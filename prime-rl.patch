+    shape, offset = compute_local_shape_and_global_offset(tensor.shape, tensor.device_mesh, tensor.placements)
+    local = tensor.to_local()
+    if tuple(local.shape) != tuple(shape):
+        raise ValueError(f"local shard is {tuple(local.shape)} where the placement says {tuple(shape)}")
