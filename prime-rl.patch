+def monkey_patch_default_renderer_strip_content():
+    from renderers.default import DefaultRenderer
+
+    original = DefaultRenderer.parse_response
+    if getattr(original, "_prime_rl_strips_content", False):
+        return
+
+    def parse_response(self, *args, **kwargs):
+        parsed = original(self, *args, **kwargs)
+        if (self.config.model_extra or {}).get("strip_content"):
+            parsed.content = parsed.content.strip()
+        return parsed
+
+    parse_response._prime_rl_strips_content = True
+    DefaultRenderer.parse_response = parse_response
