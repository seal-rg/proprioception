@@ -72,3 +72,52 @@ def stamp_advantages(rollout: Rollout) -> None:
         num_tokens = len(sample.token_ids)
         sample.advantages = list(advantages[offset : offset + num_tokens])
         offset += num_tokens
+
+
+def last_sampled_span_start(mask: list[bool]) -> int:
+    end = len(mask)
+    while end > 0 and not mask[end - 1]:
+        end -= 1
+    start = end
+    while start > 0 and mask[start - 1]:
+        start -= 1
+    return start
+
+
+def carrier_positions(rollout: Rollout) -> list[list[bool]]:
+    trainable = [index for index, sample in enumerate(rollout.samples) if any(sample.mask)]
+    positions = [[False] * len(sample.token_ids) for sample in rollout.samples]
+    if not trainable:
+        return positions
+    for index in trainable[:-1]:
+        positions[index] = list(rollout.samples[index].mask)
+    last = trainable[-1]
+    answer_start = last_sampled_span_start(rollout.samples[last].mask)
+    positions[last] = [trains and i < answer_start for i, trains in enumerate(rollout.samples[last].mask)]
+    return positions
+
+
+def stamp_carrier_kl(rollout: Rollout, coefficient: float) -> None:
+    for sample, carrier in zip(rollout.samples, carrier_positions(rollout), strict=True):
+        if not any(carrier):
+            continue
+        if sample.ref_logprobs is None:
+            raise ValueError(f"carrier tokens without reference logprobs (env '{rollout.env_name}')")
+        sample.ref_kl_weights = [coefficient if is_carrier else 0.0 for is_carrier in carrier]
+
+
+def restrict_credit_to_last_turn(rollout: Rollout) -> None:
+    trainable = [index for index, sample in enumerate(rollout.samples) if any(sample.mask)]
+    if not trainable:
+        return
+    for index in trainable[:-1]:
+        sample = rollout.samples[index]
+        sample.rl_weights = [0.0] * len(sample.token_ids)
+    last = rollout.samples[trainable[-1]]
+    span_start = last_sampled_span_start(last.mask)
+    if any(last.mask[:span_start]):
+        weights = last.rl_weights if last.rl_weights is not None else [1.0] * len(last.token_ids)
+        last.rl_weights = [0.0] * span_start + list(weights[span_start:])
+    if rollout.advantages is not None:
+        start = sum(len(sample.token_ids) for sample in rollout.samples[: trainable[-1]]) + span_start
+        rollout.advantages = [0.0] * start + list(rollout.advantages[start:])
diff --git a/src/prime_rl/orchestrator/algo/tail_rl.py b/src/prime_rl/orchestrator/algo/tail_rl.py
new file mode 100644
index 0000000..94784e6
--- /dev/null
+++ b/src/prime_rl/orchestrator/algo/tail_rl.py
@@ -0,0 +1,31 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+
+from prime_rl.orchestrator.algo.base import Algorithm
+
+if TYPE_CHECKING:
+    from prime_rl.orchestrator.types import Rollout
+
+
+def tail_weights(rewards: torch.Tensor) -> torch.Tensor:
+    order = torch.argsort(rewards)
+    sorted_rewards = rewards[order]
+    num = rewards.numel()
+    previous = torch.cat([sorted_rewards.new_zeros(1), sorted_rewards[:-1]])
+    clearing = torch.arange(num, 0, -1, dtype=rewards.dtype)
+    sorted_weights = torch.cumsum((sorted_rewards - previous) / clearing, dim=0)
+    weights = torch.empty_like(rewards)
+    weights[order] = sorted_weights
+    return weights
+
+
+class TailRLAlgorithm(Algorithm):
+    async def score_group(self, group: list[Rollout]) -> None:
+        rewards = torch.tensor([rollout.reward for rollout in group], dtype=torch.float32)
+        weights = tail_weights(rewards)
+        advantages = weights - weights.mean()
+        for rollout, advantage in zip(group, advantages.tolist(), strict=True):
+            rollout.assign_advantages(advantage)
