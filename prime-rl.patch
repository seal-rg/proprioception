+def k3_ref_kl_loss_fn(inputs: LossInputs) -> LossOutputs:
+    trainer_logprobs = inputs.trainer_logprobs
+    ref_logprobs = inputs.ref_logprobs
+    loss_mask = inputs.loss_mask
+    if ref_logprobs is None:
+        raise ValueError("the k3 ref_kl estimator requires ref_logprobs — the algorithm must score a reference model.")
+    log_ratio = torch.clamp(ref_logprobs - trainer_logprobs, min=-20.0, max=20.0)
+    k3 = torch.clamp(torch.exp(log_ratio) - log_ratio - 1, min=0.0, max=10.0)
+    per_token_loss = loss_mask * k3
+    if inputs.loss_weights is not None:
+        per_token_loss = per_token_loss * inputs.loss_weights
+    loss = per_token_loss.sum()
+    metrics = {
+        "ref_kl/k3": _safe_mean(k3, loss_mask),
+        "ref_kl/log_ratio": _safe_mean(log_ratio, loss_mask),
+    }
+    return LossOutputs(loss=loss, metrics=metrics)
+
+
+def setup_ref_kl_loss_fn(estimator: str) -> LossFn:
+    if estimator == "k3":
+        return k3_ref_kl_loss_fn
+    if estimator == "reverse_pg":
+        return ref_kl_loss_fn
+    raise ValueError(f"unknown ref_kl estimator {estimator!r}")
+
