+def monkey_patch_shared_user_server():
+    import asyncio
+    import contextlib
+
+    import verifiers.v1.rollout as rollout_module
+    from verifiers.v1.mcp import launch
+
+    original = rollout_module.serve_user
+    if getattr(original, "_prime_rl_shared_user", False):
+        return
+
+    urls: dict[str, str] = {}
+    stack = contextlib.AsyncExitStack()
+    locks: dict[int, asyncio.Lock] = {}
+
+    async def shared_url(user) -> str:
+        key = f"{type(user).__module__}.{type(user).__qualname__}:{user.config.model_dump_json()}"
+        if key not in urls:
+            loop_lock = locks.setdefault(id(asyncio.get_running_loop()), asyncio.Lock())
+            async with loop_lock:
+                if key not in urls:
+                    urls[key] = await stack.enter_async_context(launch.serve(user, None, for_host=True))
+        return urls[key]
+
+    @contextlib.asynccontextmanager
+    async def serve_user(user, harness_runtime=None, *, state_port=None, state_secret="", state_base=None):
+        if user is None or not getattr(user.config, "shared", False):
+            async with original(
+                user,
+                harness_runtime,
+                state_port=state_port,
+                state_secret=state_secret,
+                state_base=state_base,
+            ) as respond:
+                yield respond
+            return
+        base = state_base
+        if base is None and state_port is not None:
+            base = f"http://127.0.0.1:{state_port}"
+        url = launch._shared_url_for_rollout(await shared_url(user), base, state_secret)
+        async with launch.connect_user(url) as respond:
+            yield respond
+
+    serve_user._prime_rl_shared_user = True
+    rollout_module.serve_user = serve_user
